# Copie este arquivo para .env e preencha com as credenciais do seu app Web no Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → Configuração do SDK).
# O prefixo EXPO_PUBLIC_ é obrigatório para o Expo expor a variável ao app.

EXPO_PUBLIC_FIREBASE_API_KEY=sua_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu_projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=seu_app_id
